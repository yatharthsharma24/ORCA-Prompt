# Copy to .env and adjust. Every setting is optional.

# --- Local LLM (Ollama) ---
ORCA_OLLAMA_BASE_URL=http://localhost:11434
ORCA_MODEL=qwen3:8b
# Per-role overrides, e.g. a smaller model for specialists:
# ORCA_PLANNER_MODEL=qwen3:8b
# ORCA_SPECIALIST_MODEL=qwen3:4b
# ORCA_SYNTHESIZER_MODEL=qwen3:8b
ORCA_TEMPERATURE=0.1
ORCA_NUM_CTX=8192
# qwen3 can "think" before answering; slower, rarely needed with ReAct.
ORCA_THINK=false
ORCA_LLM_TIMEOUT_S=300

# --- Agent limits ---
ORCA_MAX_PLAN_STEPS=4
ORCA_MAX_REACT_ITERATIONS=6
ORCA_MAX_REVISIONS=1
ORCA_LLM_CRITIC=true

# --- Data ---
# ORCA_DATA_DB=data/orca_demo.sqlite
# ORCA_RUNS_DB=data/runs.sqlite
ORCA_ENABLE_OBIS=true

# --- Server ---
# Require an X-API-Key header on /api/ask when set:
# ORCA_API_KEY=change-me
# ORCA_CORS_ORIGINS=["https://your-frontend.example"]
ORCA_MAX_CONCURRENT_RUNS=1
ORCA_MAX_QUEUED_RUNS=4
ORCA_LOG_LEVEL=INFO
